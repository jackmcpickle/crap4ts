{
  "name": "eslint-plugin-crap",
  "version": "0.1.0",
  "description": "CRAP (Change Risk Anti-Pattern) metric for TypeScript/JavaScript as an ESLint/oxlint plugin (aka crap4ts)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "release": "commit-and-tag-version"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^9.0.0",
    "espree": "^11.2.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "crap",
    "crap4ts",
    "crap4j",
    "complexity",
    "cyclomatic",
    "coverage",
    "lcov",
    "eslint",
    "eslint-plugin",
    "oxlint",
    "typescript"
  ],
  "files": [
    "src"
  ],
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}} [skip ci]"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmcpickle/eslint-plugin-crap.git"
  },
  "homepage": "https://github.com/jackmcpickle/eslint-plugin-crap",
  "bugs": {
    "url": "https://github.com/jackmcpickle/eslint-plugin-crap/issues"
  }
}
