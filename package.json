{
  "name": "eslint-plugin-crap",
  "version": "0.1.0",
  "description": "CRAP (Change Risk Anti-Pattern) metric for TypeScript/JavaScript as an ESLint/oxlint plugin (aka crap4ts)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint ."
